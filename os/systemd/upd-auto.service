[Unit]
Description=Scheduled content update download (honours [upd] auto_apply and window)
After=network-online.target
# After a forward clock jump (or a long power-off) both Persistent= timers fire at once: let the
# metadata check finish first instead of colliding on upd's lock (exit 75, "another update is
# running"). Ordering only — the check is not pulled in.
After=upd-check.service
# Exit 75 (offline, or another download holds the lock) is not a failure, but it is retried
# every 30 minutes, at most 12 times per 6 h; next week's timer starts afresh.
StartLimitIntervalSec=6h
StartLimitBurst=12

[Service]
# exec, not oneshot: systemd refuses RestartForceExitStatus= on oneshot units. Nothing waits for
# this unit to finish (only its timer starts it).
Type=exec
SuccessExitStatus=75
RestartForceExitStatus=75
EnvironmentFile=-/etc/prepper/proxy.env
# auto_apply = false → skipped (not failed).
ExecCondition=/opt/prepper/os/bin/prepperctl auto-apply-enabled
# No --now: upd.py itself skips the run outside [upd] window.
ExecStart=/usr/bin/python3 /opt/prepper/software/upd/upd.py apply
Restart=on-failure
RestartSec=30min
# 1 = a transfer or install failed: upd keeps what it has; don't hammer the mirrors.
RestartPreventExitStatus=1
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
