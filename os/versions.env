# Pinned upstream versions. The installer fails loudly on a 404 — bump here,
# never "latest", so every Badger built from one checkout is identical.
# Checked 2026-11-16: every download URL install.sh builds from these answers
# 200 (kiwix-tools aarch64 tarball, go-pmtiles Linux_arm64 tarball, pdf.js zip,
# npm tarballs with a dist/ folder, PyPI kolibri).
KIWIX_TOOLS=3.8.2            # https://download.kiwix.org/release/kiwix-tools/
GO_PMTILES=1.31.2            # https://github.com/protomaps/go-pmtiles/releases
LLAMA_CPP_REF=v1.0.0         # https://github.com/ggml-org/llama.cpp/releases — first semver release
                             # (2026-11-13, = build b12359). Older refs are bNNNN tags.
MAPLIBRE_GL=5.6.0            # npm maplibre-gl
PMTILES_JS=4.3.0             # npm pmtiles
PROTOMAPS_BASEMAPS=5.5.1     # npm @protomaps/basemaps
LEAFLET=1.9.4                # npm leaflet
PROTOMAPS_LEAFLET=5.0.1      # npm protomaps-leaflet
PDFJS=4.10.38                # https://github.com/mozilla/pdf.js/releases
BASEMAPS_ASSETS_REF=main     # https://github.com/protomaps/basemaps-assets (fonts + sprites)
FOLIATE_JS_REF=main          # https://github.com/johnfactotum/foliate-js
KOLIBRI=0.19.5               # pip kolibri
